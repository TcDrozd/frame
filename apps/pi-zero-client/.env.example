# Copy to /opt/frame/.env on the device. Never commit the live file.

# Manifest to poll. Production key is manifest.json; frame-dash dev deploys
# publish to manifest.dev.json instead.
FRAME_MANIFEST_URL=https://trevor-shared-photo-stream.s3.us-east-1.amazonaws.com/manifest.json

# Fallback slide duration in seconds, used only when the manifest does not
# carry slide_seconds. The manifest always wins when present.
FRAME_SECONDS=1380
